{
  "description": "Nested block components fenced with runs of two or more colons.",
  "reference": "docs/specs/OMEP-0007-comark-syntax.md#nested-components",
  "cases": [
    {
      "name": "two-levels-with-distinct-colon-runs",
      "description": "The OMEP-0007 compliance table example: an opener closes on a line of exactly the same number of colons.",
      "markdown": ":::outer\n::inner\nContent\n::\n:::",
      "html": "<div>\n<div>\n<p>Content</p>\n</div>\n</div>\n",
      "ast": {
        "descend": "first:block_component",
        "attributes": { "name": "outer" },
        "exact_children": true,
        "children": [
          {
            "kind": "block_component",
            "attributes": { "name": "inner" },
            "exact_children": true,
            "children": [{ "kind": "paragraph" }]
          }
        ]
      }
    },
    {
      "name": "three-levels-with-increasing-colon-runs",
      "description": "The OMEP-0007 compliance table example: extra colons are a readability convention.",
      "markdown": "::level-1\n:::level-2\n::::level-3\nContent\n::::\n:::\n::",
      "html": "<div>\n<div>\n<div>\n<p>Content</p>\n</div>\n</div>\n</div>\n",
      "ast": {
        "descend": "first:block_component",
        "attributes": { "name": "level-1" },
        "exact_children": true,
        "children": [
          {
            "kind": "block_component",
            "attributes": { "name": "level-2" },
            "exact_children": true,
            "children": [
              {
                "kind": "block_component",
                "attributes": { "name": "level-3" },
                "exact_children": true,
                "children": [{ "kind": "paragraph" }]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "equal-colon-runs-close-innermost-first",
      "description": "Equal-colon nesting is valid; the first closing fence closes the innermost component.",
      "markdown": "::level-1\n::level-2\nContent\n::\n::\n\nAfter",
      "html": "<div>\n<div>\n<p>Content</p>\n</div>\n</div>\n<p>After</p>\n",
      "ast": {
        "kind": "document",
        "exact_children": true,
        "children": [
          {
            "kind": "block_component",
            "attributes": { "name": "level-1" },
            "exact_children": true,
            "children": [
              {
                "kind": "block_component",
                "attributes": { "name": "level-2" }
              }
            ]
          },
          { "kind": "paragraph" }
        ]
      }
    },
    {
      "name": "content-after-a-component",
      "description": "The closing fence ends the component; following blocks are siblings of it.",
      "markdown": "::a\nX\n::\n\nAfter",
      "html": "<div>\n<p>X</p>\n</div>\n<p>After</p>\n",
      "ast": {
        "kind": "document",
        "exact_children": true,
        "children": [
          { "kind": "block_component", "attributes": { "name": "a" } },
          { "kind": "paragraph" }
        ]
      }
    },
    {
      "name": "nested-components-inherit-their-own-attributes",
      "markdown": ":::outer{.o}\n::inner{.i}\nContent\n::\n:::",
      "html": "<div class=\"o\">\n<div class=\"i\">\n<p>Content</p>\n</div>\n</div>\n",
      "ast": {
        "descend": "first:block_component",
        "attributes": { "name": "outer", "class": "o" },
        "children": [
          {
            "kind": "block_component",
            "attributes": { "name": "inner", "class": "i" }
          }
        ]
      }
    }
  ]
}
